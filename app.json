{
  "expo": {
    "name": "Entao",
    "slug": "entao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "entao",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.jazzrihal.entao",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:entao.link"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Então",
        "UIBackgroundModes": [
          "processing",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.jazzrihal.entao",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Então to access your camera to capture photos for posts.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Então to attach your location to posts."
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-maps",
        {
          "requestLocationPermission": true
        }
      ],
      "expo-apple-authentication",
      "expo-notifications",
      "./plugins/withEntaoAndroidDisplayName.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0505d8dd-365b-43ec-a222-5f5425ee2ee5"
      }
    },
    "owner": "jazzrihal"
  }
}
