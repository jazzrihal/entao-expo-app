# Production — from Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Local — from `supabase status` after `supabase start`
EXPO_PUBLIC_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
# Physical device (__DEV__): tunnel to local API (e.g. `ngrok http 54321`)
EXPO_PUBLIC_SUPABASE_TUNNEL_URL=
